# Copy this file to .env and fill in the values you need.
#
#   cp .env.example .env
#
# .env is gitignored - it is the only place credentials should be written.
# application.properties imports it at startup with
# spring.config.import=optional:file:.env[.properties], so anything set here
# behaves like a normal Spring property. Environment variables of the same
# name win over the file, which is what you want on a server.
#
# The SUPABASE_DB_* block is required: it is the only database this app has,
# and without it the app refuses to start rather than falling back to anything
# local. Ask whoever runs the project for those values. Everything else below
# is optional.


# --- The first administrator ------------------------------------------------
# Accounts are rows in team_members and nowhere else. Sign-in reads that table
# and has no fallback, so an empty database is a locked door: only an admin may
# add a member, and there is no admin to do it.
#
# These two are the key to that door. Set both and the next start makes this
# address an administrator with this password, hashed, in the table. It is
# ignored entirely once one active admin has a password - so it never undoes a
# password changed on Settings > Team - and clearing both once you are in
# changes nothing.

BOOTSTRAP_ADMIN_EMAIL=admin@firsteconomy.com
BOOTSTRAP_ADMIN_PASSWORD=<a password you choose>

# --- Supabase (Postgres) - REQUIRED -----------------------------------------
# The one database. There is no embedded fallback and no default for these, so
# a checkout without them stops at startup with a message naming the ones that
# are missing. That is the point: two people running this app are meant to be
# looking at the same projects, and a local database would quietly give each of
# them their own.
#
# Dashboard > Project Settings > Database > Connection string > JDBC.
# Shown below is the session pooler, the option that behaves most like a plain
# Postgres server. For the transaction pooler use port 6543.
#
# These same values drive the migration commands (./run.sh migrate / db-info),
# which is how the schema gets onto Supabase - see db/migration/postgres.

SUPABASE_DB_HOST=aws-1-<region>.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.<project-ref>
SUPABASE_DB_PASSWORD=<database-password>

# validate | none - how Hibernate treats the schema. Flyway owns it, so
# "validate" (the default) only checks entities and schema agree. There is no
# reason to set "update"; it would fight the migrations.
SUPABASE_DB_DDL=validate
SUPABASE_DB_POOL_SIZE=5


# --- S3 ---------------------------------------------------------------------
# Attachment file storage. Leave S3_ENABLED=false and the client is never
# built, so none of the rest matters.

S3_ENABLED=false
S3_BUCKET=<bucket-name>
S3_REGION=ap-south-1

# Keys can be left out entirely: the AWS default credential chain then reads
# ~/.aws/credentials or the instance role, which keeps them out of any file.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# For real AWS, leave these two alone. For Supabase Storage, MinIO or R2, set
# the endpoint and turn on path style:
#   S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
#   S3_PATH_STYLE=true
S3_ENDPOINT=
S3_PATH_STYLE=false

# --- Email (SMTP) -----------------------------------------------------------
# Notifications are emailed to the same person the bell tells, and only then.
# Both halves have to be set: MAIL_ENABLED is this app's switch, SMTP_HOST is
# the server. With either missing nothing is sent and nothing fails - the bell
# still rings.
#
# Settings > Team shows what state this is in and will send a test message, so
# you can check the credentials without raising a bug to do it.

MAIL_ENABLED=false

# The From address. Most providers reject a message claiming to be from an
# address the account does not own, so this usually has to match SMTP_USERNAME
# or a verified sender on the account.
MAIL_FROM=bugs@firsteconomy.com
MAIL_FROM_NAME=Bug Tracking
# Where a reply should go, if not to the From address. Optional.
MAIL_REPLY_TO=

# Where this instance is reachable. It is what every link in every message
# points at, so "localhost" is right only while you are the only reader.
APP_BASE_URL=http://localhost:8085

# The server. Port 587 with STARTTLS is the common case; for the implicit-TLS
# port 465 set SMTP_PORT=465, SMTP_STARTTLS=false and add
# spring.mail.properties.mail.smtp.ssl.enable=true here as well.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=bugs@firsteconomy.com
# Gmail and Microsoft 365 both refuse an account password here - this has to be
# an app password generated for the purpose.
SMTP_PASSWORD=<app-password>
SMTP_AUTH=true
SMTP_STARTTLS=true

# What an inbox rule can match on. A trailing space is not needed; one is added.
MAIL_SUBJECT_PREFIX=[Bug Tracking]
# false leaves the title and the link in the message and keeps the report, the
# rail and the counts out of it.
MAIL_INCLUDE_DETAILS=true
