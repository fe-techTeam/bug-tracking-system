<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.6</version>
    <relativePath/>
  </parent>

  <groupId>com.bugtracking</groupId>
  <artifactId>bugtracking</artifactId>
  <version>1.0.0</version>
  <name>bugtracking</name>
  <description>Simple bug raising and tracking application</description>

  <properties>
    <java.version>21</java.version>
    <!-- AWS SDK v2 is not managed by the Spring Boot parent, so it is pinned here. -->
    <awssdk.version>2.54.10</awssdk.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Keeps every awssdk artifact on one consistent version. -->
      <dependency>
        <groupId>software.amazon.awssdk</groupId>
        <artifactId>bom</artifactId>
        <version>${awssdk.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Web layer: controllers, embedded Tomcat -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- Server-side HTML templates -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-thymeleaf</artifactId>
    </dependency>

    <!-- Database access via JPA/Hibernate -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>

    <!-- Bean validation (@NotBlank, @Size ...) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- SMTP. Inert until spring.mail.host and bugtracking.mail.enabled are
         set - see .env.example. Nothing is sent without both. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-mail</artifactId>
    </dependency>

    <!-- Login, logout, password hashing, CSRF -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>

    <!-- sec:authorize / sec:authentication in Thymeleaf templates -->
    <dependency>
      <groupId>org.thymeleaf.extras</groupId>
      <artifactId>thymeleaf-extras-springsecurity6</artifactId>
    </dependency>

    <!-- File-based H2 database, no install needed. The default. -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Postgres driver: Supabase is Postgres. Used by the "supabase" profile. -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Versioned schema migrations (src/main/resources/db/migration). Only
         the "supabase" profile runs them - H2 keeps ddl-auto=update. -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <!-- Flyway 10+ ships each database's support separately. -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>

    <!-- S3 client and presigner, for attachment storage in a bucket. -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>s3</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <!-- Migration commands against Supabase, without starting the app:
             ./run.sh migrate    apply pending migrations   (mvn flyway:migrate)
             ./run.sh db-info    show applied vs pending    (mvn flyway:info)
             ./run.sh db-repair  fix the history table      (mvn flyway:repair)
           run.sh reads .env and exports FLYWAY_URL/USER/PASSWORD, which win
           over anything configured here - so no credential lives in this file. -->
      <plugin>
        <groupId>org.flywaydb</groupId>
        <artifactId>flyway-maven-plugin</artifactId>
        <configuration>
          <!-- filesystem: so the goals work without a compile first. -->
          <locations>
            <location>filesystem:src/main/resources/db/migration/postgres</location>
          </locations>
          <!-- Adopt a database Hibernate already built instead of refusing it;
               the IF NOT EXISTS baseline then walks through it harmlessly. -->
          <baselineOnMigrate>true</baselineOnMigrate>
          <baselineVersion>0</baselineVersion>
        </configuration>
        <dependencies>
          <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>${postgresql.version}</version>
          </dependency>
          <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <version>${flyway.version}</version>
          </dependency>
        </dependencies>
      </plugin>
    </plugins>
  </build>
</project>
