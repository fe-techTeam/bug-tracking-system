# Copy this file to .env and fill in the values you need.
#
#   cp .env.example .env
#
# .env is gitignored - it is the only place credentials should be written.
# application.properties imports it at startup with
# spring.config.import=optional:file:.env[.properties], so anything set here
# behaves like a normal Spring property. Environment variables of the same
# name win over the file, which is what you want on a server.
#
# Every value below is optional. With none of them set the app runs exactly as
# it did before: H2 on disk, attachments in data/attachments.


# --- Supabase (Postgres) ----------------------------------------------------
# Only read when the app is started with the "supabase" profile:
#
#   SPRING_PROFILES_ACTIVE=supabase ./run.sh
#
# Dashboard > Project Settings > Database > Connection string > JDBC.
# Shown below is the session pooler, the option that behaves most like a plain
# Postgres server. For the transaction pooler use port 6543 and set
# SUPABASE_DB_DDL=validate.

SUPABASE_DB_HOST=aws-1-<region>.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.<project-ref>
SUPABASE_DB_PASSWORD=<database-password>

# update | validate | none - how Hibernate treats the schema. "update" creates
# and widens tables from the entity classes, same as the H2 setup.
SUPABASE_DB_DDL=update
SUPABASE_DB_POOL_SIZE=5


# --- S3 ---------------------------------------------------------------------
# Attachment file storage. Leave S3_ENABLED=false and the client is never
# built, so none of the rest matters.

S3_ENABLED=false
S3_BUCKET=<bucket-name>
S3_REGION=ap-south-1

# Keys can be left out entirely: the AWS default credential chain then reads
# ~/.aws/credentials or the instance role, which keeps them out of any file.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# For real AWS, leave these two alone. For Supabase Storage, MinIO or R2, set
# the endpoint and turn on path style:
#   S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
#   S3_PATH_STYLE=true
S3_ENDPOINT=
S3_PATH_STYLE=false
